# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# App
APP_NAME=AI Consultancy Platform
APP_VERSION=1.0.0
DEBUG=true

# Database (SQLite default — or use PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./ai_consultancy.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_consultancy

# JWT Auth
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=consultancy_docs

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Pinecone (optional — leave blank to use local ChromaDB)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=
